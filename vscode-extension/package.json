{
    "name": "translater-vscode",
    "publisher": "local",
    "displayName": "Translater for VS Code",
    "description": "Port of the Translater Chrome Extension. Supports selection translation.",
    "version": "1.4.5",
    "icon": "icon.png",
    "engines": {
        "vscode": "^1.80.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onCommand:translater.translateSelection"
    ],
    "main": "./extension.js",
    "contributes": {
        "commands": [
            {
                "command": "translater.translateSelection",
                "title": "Translate Selection"
            }
        ],
        "menus": {
            "editor/context": [
                {
                    "command": "translater.translateSelection",
                    "group": "navigation"
                }
            ]
        },
        "configuration": {
            "title": "Translater",
            "properties": {
                "translater.deepLApiKey": {
                    "type": "string",
                    "default": "",
                    "description": "API Key for DeepL Translation service."
                }
            }
        }
    },
    "scripts": {
        "lint": "eslint --ext .js src extension.js test",
        "pretest": "npm run lint",
        "test": "node ./test/runTest.js"
    },
    "devDependencies": {
        "@types/vscode": "^1.80.0",
        "@types/glob": "^8.1.0",
        "@types/mocha": "^10.0.1",
        "@types/node": "20.2.5",
        "eslint": "^8.41.0",
        "glob": "^8.1.0",
        "mocha": "^10.2.0",
        "typescript": "^5.1.3",
        "@vscode/test-electron": "^2.3.2"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/example/translater.git"
    }
}
