{
  "manifest_version": 3,
  "name": "快译 - 划词翻译助手",
  "version": "1.1.0",
  "description": "双击翻译单词显示美式音标，选中文本后悬浮按钮支持翻译和朗读，支持PDF文件",
  "permissions": [
    "activeTab",
    "webNavigation"
  ],
  "host_permissions": [
    "https://api.dictionaryapi.dev/*",
    "https://translate.googleapis.com/*",
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_end",
      "all_frames": true
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "pdfviewer.html",
        "pdfviewer.js",
        "pdfviewer.css",
        "pdf.min.mjs",
        "pdf.worker.min.mjs"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}