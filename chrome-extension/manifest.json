{
  "manifest_version": 3,
  "name": "Translater - Smart Translation Assistant",
  "version": "1.5.0",
  "description": "Double-click for dictionary, select for translation with DeepL support, PDF reader and Markdown reader integration.",
  "permissions": [
    "activeTab",
    "webNavigation",
    "storage"
  ],
  "host_permissions": [
    "https://dictionary.cambridge.org/*",
    "https://api-free.deepl.com/*",
    "https://api.deepl.com/*",
    "https://www.dictionaryapi.com/*",
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_end",
      "all_frames": true
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Translater Settings"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "pdfviewer.html",
        "pdfviewer.js",
        "pdfviewer.css",
        "mdviewer.html",
        "mdviewer.js",
        "mdviewer.css",
        "viewer-toolbar.css",
        "viewer-browser-zoom.js",
        "viewer-initial-state.js",
        "viewer-zoom-helpers.js",
        "viewer-sidebar.js",
        "viewer-routing.js",
        "viewer-sidebar-helpers.js",
        "pdf-canvas-factory.js",
        "markdown-helpers.js",
        "interaction-controller.js",
        "marked.min.js",
        "styles.css",
        "pdf.min.mjs",
        "pdf.worker.min.mjs",
        "utils.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
